{
  "manifest_version": 3,
  "name": "HLSink",
  "version": "0.3.0",
  "description": "M3U8 嗅探 + 发送到本地HLSink下载器",
  "default_locale": "zh_CN",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "HLSink"
  },
  "background": {
    "service_worker": "js/background.js"
  },
  "permissions": [
    "tabs",
    "webRequest",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "minimum_chrome_version": "102"
}